name = "m5stick-api-gate"
main = "src/index.ts"
compatibility_date = "2026-03-21"

[[kv_namespaces]]
binding = "DEVICE_STATE"
id = "REPLACE_WITH_YOUR_DEVICE_STATE_NAMESPACE_ID"

[vars]
CHAT_MODEL = "gpt-5.4-nano"
TRANSCRIBE_MODEL = "gpt-4o-mini-transcribe"
TTS_MODEL = "gpt-4o-mini-tts"
TTS_VOICE = "fable"
TTS_INSTRUCTIONS = "Speak in natural British English (RP). Avoid American pronunciation. Keep a slightly deeper tone, calm pace, and clear enunciation."
RATE_LIMIT_PER_MIN = "12"
MAX_TEXT_CHARS = "320"
MAX_REPLY_CHARS = "320"
REPLY_MAX_TOKENS = "140"

[observability]
enabled = true

[observability.logs]
enabled = true
invocation_logs = true
head_sampling_rate = 0.10
